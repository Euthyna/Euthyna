{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "euthyna": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Euthyna gateway (local)",
      "options": {
        "baseURL": "http://127.0.0.1:4517/v1"
      },
      "models": {
        "mlx-community/Qwen3-8B-4bit": {
          "name": "Qwen3-8B (vllm-metal)",
          "limit": {
            "context": 16384,
            "output": 1536
          }
        }
      }
    }
  },
  "model": "euthyna/mlx-community/Qwen3-8B-4bit",
  "permission": {
    "edit": "allow",
    "bash": "allow"
  }
}